<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>club.dwdc</groupId>
    <artifactId>club.dwdc.keyvault</artifactId>
    <version>0.6.0</version>
    <packaging>pom</packaging>

    <name>keyvault</name>
    <description>Minimal KeyVault modules used by DWDC KeyMaster.</description>

    <licenses>
        <license>
            <name>GNU General Public License v3.0 only</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>club.dwdc.keyvault.core</module>
        <module>club.dwdc.keyvault.nostr</module>
        <module>club.dwdc.keyvault.desktop</module>
        <module>club.dwdc.keyvault.cli</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.13.1</junit.version>
        <surefire.version>3.5.2</surefire.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <!-- Android API floor (mission 48.7): the app consumes this library at
                     minSdk 26. Checks every reference against the Android API 26
                     signature. Ignored: java.lang.Record (D8 always desugars records)
                     and java.lang.MatchException (javac 21 guard for exhaustive
                     switches, never reached). D8-backported methods are not allowed:
                     the check stays independent of the app's AGP version. -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>animal-sniffer-maven-plugin</artifactId>
                    <version>1.24</version>
                    <configuration>
                        <signature>
                            <groupId>com.toasttab.android</groupId>
                            <artifactId>gummy-bears-api-26</artifactId>
                            <version>0.16.0</version>
                        </signature>
                        <ignores>
                            <ignore>java.lang.Record</ignore>
                            <ignore>java.lang.MatchException</ignore>
                        </ignores>
                    </configuration>
                    <executions>
                        <execution>
                            <id>android-api-floor</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
